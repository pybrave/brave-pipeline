{
    "scatter": {
        "field": "reads",
        "mode": "each"
    },
    "inputs": [
        {
            "name": "fastq1",
            "type": "file",
            "required": true
        },
        {
            "name": "fastq2",
            "type": "file",
            "required": true
        }
    ],
    "outputs": [
        {
            "name": "fastq1_trimmed",
            "type": "file",
            "pattern": "{sample}_trimmed.fastq1.gz",
            "required": true
        },
        {
            "name": "fastq2_trimmed",
            "type": "file",
            "pattern": "{sample}_trimmed.fastq2.gz",
            "required": true
        }
    ],
    "params": {
        "minlen": {
            "type": "number",
            "default": 30
        }
    },
    "resources": {
        "cpu": 4,
        "memory": "6GB",
        "docker": "quay.io/biocontainers/trim-galore:0.6.7"
    },
    "ui": {
        "icon": "scissors",
        "color": "magenta"
    }
}