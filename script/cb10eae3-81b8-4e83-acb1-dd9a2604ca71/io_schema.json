                    "message": "\u8be5\u5b57\u6bb5\u4e0d\u80fd\u4e3a\u7a7a!"
                }
            ]
        }
    ],
    "workflow": [
        {
            "label": "SeuratObjects  File",
            "name": "seuratObjects",
            "type": "NestSelectSample",
            "input_type": "file",
            "append": [
                {
                    "name": "feature_genes",
                    "label": "feature genes",
                    "type": "BaseTextAreaNum",
                    "initialValue": "",
                    "tooltip": "Comma-separated gene list for FeaturePlot"
                },
                {
                    "name": "node_name",
                    "label": "Cell type",
                    "type": "BaseInput",
                    "initialValue": "",
                    "tooltip": "cell type"
                }
            ],
            "component_id": "DEFAULT",
            "resolver": {
                "accept_formats": [
                    "DEFAULT"
                ]
            },
            "db": true,
            "rules": [
                {
                    "required": true,
                    "message": "\u8be5\u5b57\u6bb5\u4e0d\u80fd\u4e3a\u7a7a!"
                }
            ]
        }
    ],
    "outputs": [
        {
            "name": "umap_plot",
            "type": "file",
            "pattern": "umap.png",
            "required": true
        },
        {
            "name": "feature_plot",
            "type": "file",
            "pattern": "featureplot_*.png",
            "required": false
        },
        {
            "name": "summary",
            "type": "file",
            "pattern": "output.md",
            "required": true
        }
    ],
    "params": [
        {
            "name": "dimplot_reduction",
            "label": "DimPlot reduction",
            "type": "BaseSelect",
            "initialValue": "umap",
            "data": [
                {
                    "label": "UMAP",
                    "value": "umap"
                },
                {
                    "label": "t-SNE",
                    "value": "tsne"
                }
            ],
            "tooltip": "Choose reduction for DimPlot/FeaturePlot"
        }
    ],
    "resources": {
        "cpu": 4,
        "memory": "6GB",
        "docker": "quay.io/biocontainers/trim-galore:0.6.7"
    },
    "ui": {
        "icon": "scissors",
        "color": "magenta"
    }
